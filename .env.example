# GEMINI_API_KEY: Required for Gemini AI analysis + visual verification calls.
# Get a free key at https://aistudio.google.com/apikey
# SECURITY: never commit a real key here — put it in .env (gitignored) or in
# your hosting platform's environment secrets (e.g. AI Studio Build settings).
GEMINI_API_KEY="PASTE_NEW_KEY_HERE"

# JINA_API_KEY: Required for the deep visual search engine (jina-embeddings-v5-omni-small).
# Without it, query-side visual embeddings are disabled and the app falls back
# to weaker perceptual-hash matching only (much lower accuracy, and the
# similar-products section stays empty when Gemini is offline).
# Get a free key (1M tokens) at https://jina.ai/
JINA_API_KEY="PASTE_JINA_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
